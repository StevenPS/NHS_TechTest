# Shared editor and code-style settings for all IDEs (VS, VS Code, Rider).
# https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,xml,csproj,props,targets,slnx,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,mjs,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated; keep analyzers and formatters out of them.
[src/**/Migrations/*.cs]
generated_code = true

[*.cs]
# Layout
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion

# var: use it everywhere
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Modern C#
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_readonly_field = true:suggestion

# Naming: private fields are _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Naming: interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I
